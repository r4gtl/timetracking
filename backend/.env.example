# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored and must never be committed.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. POSTGRES_HOST=localhost is correct when running manage.py
# directly on the host against the dockerized db (port published to the host).
# docker-compose.yml overrides POSTGRES_HOST=db for the backend container.
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=timetracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production only (Render) - full connection string, e.g.
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# Production only
CORS_ALLOWED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
