# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored and must never be committed.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. POSTGRES_HOST=localhost is correct when running manage.py
# directly on the host against the dockerized db (port published to the host).
# docker-compose.yml overrides POSTGRES_HOST=db for the backend container.
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=timetracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production only (Render) - full connection string, e.g.
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# Production only
CORS_ALLOWED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True

# Telegram bot integration. Leave both empty in dev if you're not testing the
# bot. TELEGRAM_BOT_TOKEN is issued by BotFather. TELEGRAM_WEBHOOK_SECRET is a
# secret string of your own choosing, sent back by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call, used to check
# that requests to the webhook really come from Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Username pubblico del bot (senza la @ iniziale, es. "MyTimetrackerBot"),
# usato per costruire il deep link https://t.me/<username>?start=<token>
# mostrato all'utente nella pagina Impostazioni.
TELEGRAM_BOT_USERNAME=
